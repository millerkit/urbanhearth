#!/bin/sh
# Only runs the heavy check when routing-sensitive files are part of the push.
# astro dev doesn't reproduce Cloudflare's own asset-serving/redirect behavior,
# so changes here need to run against the real Worker runtime before they ship.
# See TESTING.md for background (the 2026-07-03 redirect-loop incident, which
# took down every nav destination except the homepage).

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

ROUTING_PATTERN='^(astro\.config.*\.mjs|wrangler\.toml|public/_redirects|scripts/bundle-worker\.mjs|scripts/fix-preview-wrangler\.mjs)$|^src/pages/'

changed=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null)
    [ -z "$base" ] && base="$local_sha~1"
  else
    base="$remote_sha"
  fi
  files=$(git diff --name-only "$base" "$local_sha" 2>/dev/null)
  if printf '%s\n' "$files" | grep -qE "$ROUTING_PATTERN"; then
    changed="yes"
  fi
done

if [ -z "$changed" ]; then
  exit 0
fi

echo "› Routing-sensitive files changed — smoke-testing against a real Cloudflare Worker runtime"

BUILD_LOG=$(mktemp)
if ! pnpm build > "$BUILD_LOG" 2>&1; then
  echo "✘ Build failed:"
  tail -30 "$BUILD_LOG"
  exit 1
fi

PORT=8799
WRANGLER_LOG=$(mktemp)
(cd dist/server && exec npx wrangler dev --config wrangler.json --port "$PORT") > "$WRANGLER_LOG" 2>&1 &
WRANGLER_PID=$!

cleanup() {
  kill "$WRANGLER_PID" 2>/dev/null
  pkill -P "$WRANGLER_PID" 2>/dev/null
  wait "$WRANGLER_PID" 2>/dev/null
}
trap cleanup EXIT

ready=""
for i in $(seq 1 20); do
  if curl -s -o /dev/null "http://localhost:$PORT/"; then
    ready="yes"
    break
  fi
  sleep 1
done

if [ -z "$ready" ]; then
  echo "✘ Local Worker never came up:"
  tail -30 "$WRANGLER_LOG"
  exit 1
fi

# Every top-nav / footer destination. The incident that prompted this hook
# broke every one of these except the homepage, even though the diff never
# touched src/pages/ at all — a Cloudflare asset-layer default conflicted
# with an unrelated astro.config.mjs change. So this checks the whole nav,
# not just files in the diff.
ROUTES="/ /dining-options /reservations /reservation-policy /menus/a-la-carte /menus/chefs-counter-menu /menus/wine /menus/spirits-cocktails /menus/beer-cider /about /chef /team /blog /gallery /large-parties /gift-cards /mailing-list-signup /faq /products"

# /menus is a redirect-only page (Astro.redirect in a prerendered route), so
# Astro serves it as a 200 with a client-side meta-refresh stub rather than a
# real 3xx — curl -L can't follow that, and real content-page assertions
# would false-positive on it. Check its actual redirect target instead.
REDIRECT_ROUTES="/menus:/menus/a-la-carte"

fail=0
BODY_FILE=$(mktemp)
for route in $ROUTES; do
  code=$(curl -s -o "$BODY_FILE" -w "%{http_code}" -L --max-redirs 10 "http://localhost:$PORT$route")
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "✘ $route -> curl error $status (likely a redirect loop)"
    fail=1
    continue
  fi
  if [ "$code" -ge 400 ]; then
    echo "✘ $route -> HTTP $code"
    fail=1
    continue
  fi
  # Status codes alone don't catch a page that "succeeds" but renders the
  # wrong thing (blank content, an error boundary, a stale/broken layout).
  # Every real page shares the site chrome, so its absence means something
  # upstream broke even though the request itself returned 200.
  if ! grep -q 'id="site-nav"' "$BODY_FILE"; then
    echo "✘ $route -> HTTP $code but missing the site nav (page didn't render normally)"
    fail=1
  elif ! grep -q "Urban Hearth" "$BODY_FILE"; then
    echo "✘ $route -> HTTP $code but missing site branding (page didn't render normally)"
    fail=1
  fi
done

for pair in $REDIRECT_ROUTES; do
  route="${pair%%:*}"
  target="${pair##*:}"
  code=$(curl -s -o "$BODY_FILE" -w "%{http_code}" -L --max-redirs 10 "http://localhost:$PORT$route")
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "✘ $route -> curl error $status (likely a redirect loop)"
    fail=1
  elif ! grep -q "$target" "$BODY_FILE"; then
    echo "✘ $route -> HTTP $code but doesn't point at $target"
    fail=1
  fi
done
rm -f "$BODY_FILE"

if [ "$fail" -eq 1 ]; then
  echo "✘ Route smoke test failed against the real Worker runtime. Push blocked."
  echo "  Reproduce: pnpm build && cd dist/server && npx wrangler dev --config wrangler.json"
  echo "  Full server log: $WRANGLER_LOG"
  echo "  Emergency bypass: git push --no-verify"
  exit 1
fi

echo "✓ Route smoke test passed"
