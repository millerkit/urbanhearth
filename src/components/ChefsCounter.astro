---
import { getSiteSettings } from "../lib/site-settings";
import { isSanityConfigured } from "../lib/sanity";
import { fetchChefsCounter } from "../lib/sanity-fetch";
import cardFallback from "../fallback-content/chefs-counter.json";
import ReservationButton from "./ReservationButton.astro";
import "../styles/menu-shared.css";

const restaurant = await getSiteSettings();

let card: typeof cardFallback = cardFallback;
if (isSanityConfigured) {
  try {
    const data = await fetchChefsCounter();
    if (data) card = data;
  } catch (e) {
    console.error("Failed to fetch Chef's Counter from Sanity:", e);
  }
}
---

<div class="menu-card card">
  <div class="card-header">
    <div class="eyebrow-group">
      <p class="menu-eyebrow">{card.eyebrow}</p>
      <p class="reservations-note">{card.finePrint}</p>
    </div>
    <ReservationButton
      href={`${restaurant.reservations.href}#chefs-counter`}
      label="Reserve your seat"
    />
  </div>
  <div class="price">{card.price} <span>{card.priceLabel}</span></div>
  <p class="desc">{card.description}</p>
  <div class="sub-row">
    <span class="menu-label">{card.winePairingLabel}</span>
    <span class="sub-value">{card.winePairingValue}</span>
  </div>
</div>

<style>
  .card {
    padding: 2.5rem 2rem;
  }

  .price {
    font-family: var(--font-body), serif;
    font-size: 2.4rem;
    font-weight: 300;
    color: var(--midnight);
    line-height: 1;
    margin-bottom: 1.2rem;
  }

  .price span {
    font-family: var(--font-header-action), sans-serif;
    font-size: 14px;
    font-weight: 300;
    color: var(--ink);
    letter-spacing: 0.1em;
  }

  .desc {
    font-family: var(--font-body), serif;
    font-size: var(--text-md);
    font-weight: 300;
    line-height: 1.8;
    color: var(--midnight);
    margin-bottom: 1.5rem;
  }

  .sub-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.75rem 0;
    border-top: 1px solid rgba(22, 34, 53, 0.13);
    border-bottom: 1px solid rgba(22, 34, 53, 0.13);
    margin-bottom: 1.2rem;
  }

  .sub-value {
    font-family: var(--font-header-action), sans-serif;
    font-size: 15px;
    font-weight: 300;
    color: var(--midnight);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 1.5rem;
    margin-bottom: 1.2rem;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .reservations-note {
    font-family: var(--font-header-action), sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: var(--ink);
    line-height: 1.6;
  }
</style>
