---
import { getSiteSettings } from "../lib/site-settings";
import { isSanityConfigured } from "../lib/sanity";
import { fetchChefsCounter } from "../lib/sanity-fetch";
import cardFallback from "../fallback-content/chefs-counter.json";
import "../styles/menu-shared.css";

const restaurant = await getSiteSettings();

let card: typeof cardFallback = cardFallback;
if (isSanityConfigured) {
  try {
    const data = await fetchChefsCounter();
    if (data) card = data;
  } catch (e) {
    console.error("Failed to fetch Chef's Counter from Sanity:", e);
  }
}
---

<div class="menu-card card">
  <p class="menu-eyebrow">{card.eyebrow}</p>
  <div class="price">{card.price} <span>{card.priceLabel}</span></div>
  <p class="desc">{card.description}</p>
  <div class="sub-row">
    <span class="menu-label">{card.winePairingLabel}</span>
    <span class="sub-value">{card.winePairingValue}</span>
  </div>
  <p class="menu-fine-print note">{card.finePrint}</p>
  <a href={`${restaurant.reservations.href}#chefs-counter`} class="cta"
    >Reserve your seat</a
  >
</div>

<style>
  .card {
    padding: 2.5rem 2rem;
  }

  .price {
    font-family: var(--font-body), serif;
    font-size: 2.4rem;
    font-weight: 300;
    color: var(--midnight);
    line-height: 1;
    margin-bottom: 1.2rem;
  }

  .price span {
    font-family: var(--font-header-action), sans-serif;
    font-size: 12px;
    font-weight: 300;
    color: var(--charcoal);
    letter-spacing: 0.1em;
  }

  .desc {
    font-family: var(--font-body), serif;
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.8;
    color: var(--midnight);
    margin-bottom: 1.5rem;
  }

  .sub-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.75rem 0;
    border-top: 1px solid rgba(22, 34, 53, 0.13);
    border-bottom: 1px solid rgba(22, 34, 53, 0.13);
    margin-bottom: 1.2rem;
  }

  .sub-value {
    font-family: var(--font-header-action), sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: var(--midnight);
  }

  .note {
    margin-bottom: 1.8rem;
  }

  .cta {
    display: inline-block;
    font-family: var(--font-header-action), sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--midnight);
    text-decoration: none;
    border-bottom: 1px solid rgba(22, 34, 53, 0.4);
    padding-bottom: 2px;
    transition: opacity 0.2s;
  }

  .cta:hover {
    opacity: 0.6;
  }
</style>
