---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  leadNote?: string;
}
const { eyebrow, title, lead, leadNote } = Astro.props;
---

<header class="page-header">
  {eyebrow && <p class="section-eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {
    lead && (
      <p class="page-lead">
        {lead}
        {leadNote && (
          <>
            <br />
            <span class="page-lead-note">Note: {leadNote}</span>
          </>
        )}
      </p>
    )
  }
  <slot />
</header>

<style>
  .page-header {
    text-align: center;
    padding: 2rem 2rem 2.5rem;
    border-bottom: 1px solid var(--border);
    background: var(--warm-white);
  }

  .section-eyebrow {
    margin-bottom: 1.4rem;
  }

  h1 {
    margin-bottom: 1.5rem;
  }

  .page-lead {
    font-family: var(--font-body), serif;
    font-size: var(--text-md);
    font-weight: 400;
    color: var(--ink);
    max-width: 760px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .page-lead-note {
    font-style: italic;
  }
</style>
