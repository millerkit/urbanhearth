---
import MenuItem from "./MenuItem.astro";

interface Props {
  section: {
    title?: string;
    items?: any[];
  };
}

const { section } = Astro.props;
---

<section class="menu-section">
  <h2 class="menu-label menu-section-title">{section.title}</h2>
  <ul class="dish-list">
    {section.items?.map((item: any) => <MenuItem section={item} />)}
  </ul>
</section>

<style>
  .menu-section {
    margin-bottom: 3.5rem;
  }

  .menu-section:last-of-type {
    margin-bottom: 2.5rem;
  }

  .menu-section-title {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .dish-list {
    list-style: none;
  }
</style>
