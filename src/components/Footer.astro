---
import { getSiteSettings } from "../lib/site-settings";
import { isSanityConfigured } from "../lib/sanity";
import { fetchFooterLinks } from "../lib/sanity-fetch";
import footerLinksFallback from "../fallback-content/footer-links.json";
import RestaurantHours from "./RestaurantHours.astro";

const restaurant = await getSiteSettings();

let footerLinks: {
  secondaryLinks: { label: string; href: string }[];
  legalLinks: { label: string; href: string }[];
} = footerLinksFallback;

if (isSanityConfigured) {
  try {
    const data = await fetchFooterLinks();
    if (data) footerLinks = data;
  } catch (e) {
    console.error("Failed to fetch footer links from Sanity:", e);
  }
}

interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  year?: number;
  symbol?: string;
  secondaryLinks?: FooterLink[];
  legalLinks?: FooterLink[];
}

const { year = new Date().getFullYear(), symbol = "✦" } = Astro.props;

const [streetAddress, ...cityParts] = restaurant.address.split(",");
const addressLines = [streetAddress, cityParts.join(",").trim()];
---

<footer>
  <nav class="footer-nav">
    {
      footerLinks.secondaryLinks.map(({ label, href }) => {
        const isExternal = href.startsWith("http");
        const isInstagram = href.includes("instagram.com");
        return (
          <a
            href={href}
            {...(isExternal
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
            {...(isInstagram
              ? { "aria-label": "Urban Hearth on Instagram" }
              : {})}
          >
            {isInstagram ? (
              <>
                <span class="instagram-label">{label}</span>
                <svg
                  class="instagram-icon"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                  fill="currentColor"
                >
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z" />
                </svg>
              </>
            ) : (
              label
            )}
          </a>
        );
      })
    }
  </nav>

  <div class="footer-info">
    <div class="footer-col">
      <p class="footer-col-title">Visit</p>
      <address>
        <a
          href={restaurant.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-address"
        >
          {
            addressLines.map((line, i) => (
              <>
                {line.trim()}
                {i < addressLines.length - 1 ? <br /> : null}
              </>
            ))
          }
        </a>
        <br />T: <a
          href={`tel:${restaurant.phone.replace(/\s/g, "")}`}
          class="footer-email">{restaurant.phone}</a
        >
      </address>
    </div>

    <div class="footer-col center">
      <p class="footer-col-title">Dining hours</p>
      <RestaurantHours class="footer-hours-line" />
    </div>

    <div class="footer-col right">
      <p class="footer-col-title">Email</p>
      <address>
        <span class="footer-email-note">general:</span><a
          href="mailto:info@urbanhearth.net"
          class="footer-email">info@urbanhearth.net</a
        >
        <br /><span class="footer-email-note">reservations:</span><a
          href="mailto:concierge@urbanhearth.net"
          class="footer-email">concierge@urbanhearth.net</a
        >
        <br /><span class="footer-email-note">groups & events:</span><a
          href={`mailto:${restaurant.privateDiningEmail}`}
          class="footer-email">{restaurant.privateDiningEmail}</a
        >
      </address>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© {year} {restaurant.name} Restaurant</span>
    <div class="footer-bottom-links">
      {
        footerLinks.legalLinks.map(({ label, href }) => (
          <a href={href}>{label}</a>
        ))
      }
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--cream);
    border-top: 1px solid var(--border);
  }

  .symbol {
    font-size: 1.375rem;
    color: var(--ink-light);
    margin-bottom: 0.4rem;
  }

  .year {
    font-family: var(--font-header-action), sans-serif;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-light);
  }

  .footer-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 2.8rem;
    padding: 1.8rem 2rem;
    border-bottom: 1px solid var(--border);
  }

  .footer-nav a {
    font-family: var(--font-header-action), sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .footer-nav a:hover {
    opacity: 0.5;
  }

  .instagram-icon {
    display: none;
    width: 14px;
    height: 14px;
  }

  @media (max-width: 700px) {
    .footer-nav {
      gap: 0 1.4rem;
      padding: 1.4rem 1.25rem;
    }

    .instagram-label {
      display: none;
    }

    .instagram-icon {
      display: block;
    }
  }

  .footer-info {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    padding: 2.5rem 2rem;
    border-bottom: 1px solid var(--border);
  }

  .footer-col-title {
    font-family: var(--font-header-action), sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .footer-col p,
  .footer-col address,
  :global(.footer-hours-line) {
    font-family: var(--font-header-action), sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink);
    font-style: normal;
    letter-spacing: 0.04em;
  }

  .footer-address {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .footer-address:hover {
    opacity: 0.6;
  }

  .footer-email {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition: opacity 0.2s;
  }
  .footer-email:hover {
    opacity: 0.6;
  }

  .footer-email-note {
    padding-right: 10px;
  }

  .footer-col.center {
    text-align: center;
  }
  .footer-col.right {
    text-align: right;
  }

  .footer-bottom {
    background: var(--midnight);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-bottom span {
    font-family: var(--font-header-action), sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .footer-bottom-links {
    display: flex;
    gap: 2rem;
  }

  .footer-bottom-links a {
    font-family: var(--font-header-action), sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-bottom-links a:hover {
    color: rgba(255, 255, 255, 0.8);
  }

  @media (max-width: 700px) {
    .footer-info {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-col.right,
    .footer-col.center {
      text-align: left;
    }
  }
</style>
