---
import { getSiteSettings } from "../lib/site-settings";
import { isSanityConfigured } from "../lib/sanity";
import { fetchMenusPage } from "../lib/sanity-fetch";
import menusPageFallback from "../fallback-content/menus-page.json";
import RestaurantHours from "./RestaurantHours.astro";
import ReservationButton from "./ReservationButton.astro";
import MenuSection from "./MenuSection.astro";

const restaurant = await getSiteSettings();

let menusPage = {
  walkInsNote: menusPageFallback.walkInsNote,
  menuFooterNote: menusPageFallback.menuFooterNote,
};
if (isSanityConfigured) {
  try {
    const data = await fetchMenusPage();
    if (data) menusPage = { ...menusPage, ...data };
  } catch (e) {
    console.error("Failed to fetch menus page from Sanity:", e);
  }
}

interface Props {
  menu: {
    sections?: any[];
    footer_note?: string;
  };
}

const { menu } = Astro.props;
---

<div class="menu-card menu-main">
  <div class="menu-dining-room">
    <div class="dining-room-text">
      <p class="menu-eyebrow">Dining Room</p>
      <RestaurantHours class="dining-room-hours" />
      <p class="dining-room-hours">{menusPage.walkInsNote}</p>
    </div>
    <ReservationButton
      href={`${restaurant.reservations.href}#dining-room`}
      label="Reserve a table"
    />
  </div>

  {menu.sections?.map((section: any) => <MenuSection section={section} />)}

  <p class="menu-fine-print menu-footer-note">
    {menu.footer_note ?? menusPage.menuFooterNote}
  </p>
</div>

<style>
  .menu-main {
    padding: 2.5rem 3rem 3rem;
  }

  .menu-dining-room {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 0 0 2rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .dining-room-hours {
    font-family: var(--font-header-action), sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: var(--ink-mid);
    line-height: 1.6;
  }

  .menu-footer-note {
    font-size: 12px;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  @media (max-width: 500px) {
    .menu-main {
      padding: 2rem 1.25rem;
    }
  }
</style>
