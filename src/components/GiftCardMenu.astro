---
// A small floating pill that links to /gift-cards. Phones only: on desktop the
// nav already has a Gift Cards link, but on mobile it's hidden in the hamburger
// menu. Hidden on /gift-cards itself, where it would only link to itself.
const showTab = Astro.url.pathname.replace(/\/+$/, "") !== "/gift-cards";
---

{
  showTab && (
    <a href="/gift-cards" class="gift-tab" aria-label="Buy a gift card">
      <svg
        class="gift-tab__icon"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <rect x="3" y="8" width="18" height="4" />
        <path d="M5 12v9h14v-9M12 8v13" />
        <path d="M12 8c-1-4-6-4-5-1 .6 1.6 3 1 5 1zm0 0c1-4 6-4 5-1-.6 1.6-3 1-5 1z" />
      </svg>
      <span>Buy Gift Card</span>
    </a>
  )
}

<script>
  document.querySelector(".gift-tab")?.addEventListener("click", () => {
    try {
      (window as any).trackEvent?.("Gift card: tab click");
    } catch (_) {}
  });
</script>

<style>
  .gift-tab {
    display: none; /* desktop: the nav has a Gift Cards link */
    position: fixed;
    z-index: 98;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.2rem;
    font-family: var(--font-header-action), sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--midnight);
    background: var(--parchment);
    border: 1px solid var(--midnight);
    box-shadow: 0 6px 18px rgba(22, 34, 53, 0.22);
    transition:
      background 0.2s,
      color 0.2s;
  }

  .gift-tab__icon {
    color: var(--copper);
    flex-shrink: 0;
    transition: color 0.2s;
  }

  .gift-tab:hover,
  .gift-tab:focus-visible {
    background: var(--midnight);
    color: #fff;
  }

  .gift-tab:hover .gift-tab__icon,
  .gift-tab:focus-visible .gift-tab__icon {
    color: var(--copper-light);
  }

  .gift-tab:focus-visible {
    outline: 2px solid var(--midnight);
    outline-offset: 3px;
  }

  @media (max-width: 700px) {
    .gift-tab {
      /* Floats bottom-right: easy to reach with a thumb and clear of page
         titles. */
      display: inline-flex;
      right: 1rem;
      bottom: calc(1rem + env(safe-area-inset-bottom));
      padding: 0.95rem 1.25rem;
    }
  }
</style>
