---
import { getSiteSettings } from "../lib/site-settings";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { isSanityConfigured } from "../lib/sanity";
import { fetchMailingListPage } from "../lib/sanity-fetch";
import pageFallback from "../fallback-content/mailing-list-page.json";

const restaurant = await getSiteSettings();

let page = pageFallback;

if (isSanityConfigured) {
  try {
    const fetched = await fetchMailingListPage();
    if (fetched?.pageTitle) page = fetched;
  } catch (e) {
    console.error("Failed to fetch mailing list page from Sanity:", e);
  }
}
---

<Base
  title={`${page.pageTitle} — ${restaurant.name}`}
  description={page.seoDescription}
>
  <div class="newsletter-page">
    <PageHeader
      eyebrow={page.eyebrow}
      title={page.pageTitle}
      lead={page.pageLead}
    />

    <div class="form-section">
      <form
        id="newsletter-form"
        class="newsletter-form"
        novalidate
        data-submit-label={page.submitLabel}
      >
        <div class="form-row form-row--two">
          <div class="form-field">
            <label for="first-name">First name</label>
            <input
              type="text"
              id="first-name"
              name="first_name"
              required
              autocomplete="given-name"
            />
          </div>
          <div class="form-field">
            <label for="last-name">Last name</label>
            <input
              type="text"
              id="last-name"
              name="last_name"
              required
              autocomplete="family-name"
            />
          </div>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label for="email">Email address</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
            />
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="form-submit">{page.submitLabel}</button>
        </div>

        <p class="form-error" hidden>
          Something went wrong signing you up. Please try again, or email us
          directly at <a href="mailto:info@urbanhearth.net"
            >info@urbanhearth.net</a
          >.
        </p>
      </form>

      <div class="form-success" hidden>
        <p class="section-eyebrow">{page.successEyebrow}</p>
        <p class="form-success-msg">{page.successMessage}</p>
      </div>
    </div>
  </div>
</Base>

<script is:inline>
  (function () {
    const form = document.getElementById("newsletter-form");
    if (!form) return;

    const submitLabel = form.dataset.submitLabel || "Join the List";
    form.addEventListener("submit", async function (e) {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const btn = form.querySelector('button[type="submit"]');
      const errorMsg = form.querySelector(".form-error");
      btn.disabled = true;
      btn.textContent = "Sending…";
      if (errorMsg) errorMsg.hidden = true;

      try {
        const res = await fetch("https://formspree.io/f/meeddqvl", {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (res.ok) {
          form.hidden = true;
          document.querySelector(".form-success").hidden = false;
        } else {
          btn.disabled = false;
          btn.textContent = submitLabel;
          if (errorMsg) errorMsg.hidden = false;
        }
      } catch (_) {
        btn.disabled = false;
        btn.textContent = submitLabel;
        if (errorMsg) errorMsg.hidden = false;
      }
    });
  })();
</script>

<style>
  .newsletter-page {
    margin-top: 111px;
  }

  .form-section {
    max-width: 560px;
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
  }

  /* ── Form rows ── */
  .form-row {
    margin-bottom: 2rem;
  }

  .form-row--two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-field label {
    font-family: var(--font-header-action), sans-serif;
    font-size: var(--text-label);
    font-weight: 300;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mid);
  }

  .form-field input {
    font-family: var(--font-header-action), sans-serif;
    font-size: var(--text-sm);
    font-weight: 300;
    color: var(--ink);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 0;
    outline: none;
    width: 100%;
    transition: border-color 0.2s;
    -webkit-appearance: none;
    appearance: none;
  }

  .form-field input:focus {
    border-bottom-color: var(--ink);
  }

  .form-field input::placeholder {
    color: var(--ink-light);
    font-style: italic;
  }

  /* ── Submit ── */
  .form-actions {
    margin-top: 2.5rem;
    text-align: center;
  }

  .form-submit {
    font-family: var(--font-header-action), sans-serif;
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--parchment);
    background: var(--midnight);
    border: none;
    padding: 0.9rem 3rem;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .form-submit:hover {
    opacity: 0.8;
  }

  .form-submit:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .form-error {
    margin-top: 1.25rem;
    font-family: var(--font-body), serif;
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.5;
    color: #b94a4a;
    text-align: center;
  }

  .form-error a {
    color: inherit;
  }

  /* ── Success ── */
  .form-success {
    text-align: center;
    padding: 2rem 0;
  }

  .form-success .section-eyebrow {
    margin-bottom: 1rem;
  }

  .form-success-msg {
    font-family: var(--font-body), serif;
    font-size: 1.1rem;
    font-weight: 300;
    line-height: 1.8;
    color: var(--ink);
  }

  /* ── Responsive ── */
  @media (max-width: 500px) {
    .form-row--two {
      grid-template-columns: 1fr;
    }
  }
</style>
