---
import { getSiteSettings } from "../lib/site-settings";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";

const restaurant = await getSiteSettings();
---

<Base
  title={`Large Parties — ${restaurant.name}`}
  description="Large party reservations and private events at Urban Hearth in Cambridge, MA."
>
  <div class="large-parties">
    <PageHeader
      title="Group Bookings"
      lead="Some occasions deserve a little more room around the table."
    />

    <div class="body">
      <h2 class="section-eyebrow">Large Parties</h2>
      <p>
        Whether you're planning an intimate celebration, a business dinner, or
        simply gathering a group of friends, Urban Hearth offers a variety of
        options for larger parties.
      </p>

      <ul>
        <li>
          Available for 7–30 guests in the dining room and up to 20 guests in
          the salon.
        </li>
        <li>Minimum food &amp; beverage purchase is required.</li>
        <li>
          We will work with you to create customized menus that reflect the
          season and the spirit of your occasion. Menu options may be limited.
        </li>
        <li>
          Our concierge team will guide you through menu selections, beverage
          pairings, and event details to ensure a seamless experience from
          beginning to end.
        </li>
      </ul>

      <p class="contact">
        To inquire, email us at <a
          href={`mailto:${restaurant.privateDiningEmail}`}
          >{restaurant.privateDiningEmail}</a
        >.
      </p>
    </div>

    <div class="body private-events">
      <h2 class="section-eyebrow">Private Events</h2>
      <p>
        Urban Hearth is also available for bespoke private events, including
        weddings, milestone celebrations, corporate gatherings, and full
        restaurant buyouts. We build an exclusive event program tailored to your
        needs, and the restaurant space will be reserved exclusively for your
        group on the chosen evening.
      </p>
      <p>
        To learn more about availability, pricing, and event options, please
        contact our concierge team at <a
          href={`mailto:${restaurant.privateDiningEmail}`}
          >{restaurant.privateDiningEmail}</a
        >.
      </p>
    </div>
  </div>
</Base>

<style>
  .large-parties {
    margin-top: 111px;
  }

  .body {
    max-width: 720px;
    margin: 0 auto;
    padding: 1.25rem 2rem 2.5rem;
  }

  .body p {
    font-family: var(--font-body), serif;
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--ink);
  }

  .body p + p {
    margin-top: 0.75rem;
  }

  .body ul {
    margin: 0.75rem 0;
    padding-left: 1.25rem;
  }

  .body li {
    font-family: var(--font-body), serif;
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--ink);
    margin-bottom: 0.35rem;
  }

  .contact {
    margin-top: 1rem;
  }

  .body .section-eyebrow {
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .private-events {
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
  }
</style>
