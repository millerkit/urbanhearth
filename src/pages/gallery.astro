---
import { getSiteSettings } from "../lib/site-settings";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";

import img1 from "../assets/photos/gallery/gallery-image-1.jpg";
import img2 from "../assets/photos/gallery/gallery-image-2.jpg";
import img3 from "../assets/photos/gallery/gallery-image-3.jpg";
import img4 from "../assets/photos/gallery/gallery-image-4.jpg";
import img5 from "../assets/photos/gallery/gallery-image-5.jpg";
import img6 from "../assets/photos/gallery/gallery-image-6.jpg";
import img7 from "../assets/photos/gallery/gallery-image-7.jpg";
import img8 from "../assets/photos/gallery/gallery-image-8.jpg";
import img9 from "../assets/photos/gallery/gallery-image-9.jpg";
import img10 from "../assets/photos/gallery/gallery-image-10.jpg";
import img11 from "../assets/photos/gallery/gallery-image-11.jpg";
import img12 from "../assets/photos/gallery/gallery-image-12.jpg";
import img13 from "../assets/photos/gallery/gallery-image-13.jpg";
import img14 from "../assets/photos/gallery/gallery-image-14.jpg";
import img15 from "../assets/photos/gallery/gallery-image-15.jpg";
import img16 from "../assets/photos/gallery/gallery-image-16.jpg";

const restaurant = await getSiteSettings();

const photos = [
  img1,
  img2,
  img3,
  img4,
  img5,
  img6,
  img7,
  img8,
  img9,
  img10,
  img11,
  img12,
  img13,
  img14,
  img15,
  img16,
];
---

<Base
  title={`Gallery — ${restaurant.name}`}
  description="A look inside Urban Hearth — the dining room, bar, and kitchen."
>
  <div class="gallery-page">
    <PageHeader title="Gallery" />

    <div class="gallery-grid">
      {
        photos.map((src, i) => (
          <div class="gallery-item">
            <img src={src.src} alt="" loading={i < 4 ? "eager" : "lazy"} />
          </div>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .gallery-page {
    margin-top: 111px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3px;
    width: 80%;
    margin: 0 auto 2.5rem;
    background: var(--border);
    border-bottom: 1px solid var(--border);
  }

  .gallery-item {
    overflow: hidden;
    background: var(--parchment);
    aspect-ratio: 4 / 5;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.03);
  }

  @media (max-width: 900px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .gallery-item {
      aspect-ratio: 4 / 3;
    }
  }
</style>
