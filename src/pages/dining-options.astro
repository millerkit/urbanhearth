---
import { getSiteSettings } from "../lib/site-settings";
import { isSanityConfigured } from "../lib/sanity";
import { fetchDiningOptions } from "../lib/sanity-fetch";
import diningOptionsFallback from "../fallback-content/dining-options.json";
import page from "../fallback-content/dining-options-page.json";
import diningRoomFallback from "../assets/photos/OptionsDiningRoomTeaser.jpeg";
import chefsCounterFallback from "../assets/photos/OptionsChefsCounterTeaserLarge.jpeg";
import barFallback from "../assets/photos/OptionsBarTeaser.jpeg";
import salonFallback from "../assets/photos/OptionsSalonTeaser.jpeg";
import bottomBarPhoto from "../assets/photos/OptionsBottomBarTeaser.jpeg";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import ReservationButton from "../components/ReservationButton.astro";

const restaurant = await getSiteSettings();

// Per-area photo fallbacks keyed by anchor id
const photoFallbacks: Record<string, string> = {
  "dining-room": diningRoomFallback.src,
  "chefs-counter": chefsCounterFallback.src,
  salon: barFallback.src,
};

const photoSecondaryFallbacks: Record<string, string> = {
  "chefs-counter": diningRoomFallback.src,
  salon: salonFallback.src,
};

let options = diningOptionsFallback;
if (isSanityConfigured) {
  try {
    const data = await fetchDiningOptions();
    if (data?.length) options = data;
  } catch (e) {
    console.error("Failed to fetch dining options from Sanity:", e);
  }
}
---

<Base
  title={`${page.pageTitle} — ${restaurant.name}`}
  description={page.seoDescription}
>
  <div class="dining-page">
    <PageHeader title={page.pageTitle} lead={page.pageLead} />

    {
      options.map((area, i) => {
        const photoSrc = area.photo ?? photoFallbacks[area.id];
        const photoSecondarySrc =
          area.photoSecondary ?? photoSecondaryFallbacks[area.id];
        const ctaHref = area.phoneReserve
          ? `tel:${restaurant.phone.replace(/\s/g, "")}`
          : `${restaurant.reservations.href}#${area.id}`;
        return (
          <section class={`area ${area.dark ? "area--dark" : ""}`} id={area.id}>
            <div
              class={`area-photo-wrap${photoSecondarySrc ? " area-photo-wrap--dual" : ""}`}
            >
              <img
                src={photoSrc}
                alt={area.photoAlt}
                class="area-photo"
                loading={i === 0 ? "eager" : "lazy"}
              />
              {photoSecondarySrc && (
                <img
                  src={photoSecondarySrc}
                  alt={area.photoSecondaryAlt ?? ""}
                  class="area-photo"
                  loading="lazy"
                />
              )}
            </div>

            <div class="area-body">
              <div class="area-body-inner">
                <h2 class="area-title">{area.title}</h2>
                <div class="area-desc">
                  {area.description.map((p) => (
                    <p set:html={p} />
                  ))}
                </div>
                {(area.phoneReserve || area.ctaLabel) && (
                  <div class="area-cta">
                    {area.phoneReserve ? (
                      <div class="phone-reserve">
                        <span class="phone-num">
                          <a
                            href={`tel:${restaurant.phone.replace(/\s/g, "")}`}
                          >
                            {restaurant.phone}
                          </a>
                        </span>
                        <span class="phone-or">or email</span>
                        <a
                          href={`mailto:${restaurant.privateDiningEmail}`}
                          class="text-cta"
                        >
                          {restaurant.privateDiningEmail}
                        </a>
                      </div>
                    ) : (
                      <ReservationButton href={ctaHref} label={area.ctaLabel} />
                    )}
                  </div>
                )}
              </div>
            </div>
          </section>
        );
      })
    }
  </div>
  <div class="bottom-photo-wrap">
    <img
      src={bottomBarPhoto.src}
      alt="Bar at Urban Hearth"
      class="bottom-photo"
      loading="lazy"
    />
  </div>
</Base>

<style>
  .dining-page {
    margin-top: 103px;
  }

  .dining-page :global(.page-header) {
    padding-bottom: 1rem;
  }

  /* ── Quick-nav ── */
  .area-nav {
    display: flex;
    justify-content: center;
    gap: 0;
    border-bottom: 1px solid var(--border);
    background: var(--warm-white);
  }

  .area-nav-link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1.1rem 2.5rem;
    font-family: var(--font-header-action) sans-serif;
    font-size: var(--text-fine);
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mid);
    text-decoration: none;
    border-right: 1px solid var(--border);
    transition: color 0.2s;
  }

  .area-nav-link:first-child {
    border-left: 1px solid var(--border);
  }

  .area-nav-link:hover {
    color: var(--ink);
  }

  .area-nav-num {
    color: var(--ink-light);
  }

  /* ── Area section ── */
  .area {
    border-bottom: 1px solid var(--border);
    background: var(--warm-white);
  }

  .area--dark {
    background: var(--midnight);
  }

  /* ── Photo ── */
  .area-photo-wrap {
    position: relative;
    width: 80%;
    margin: 2.5rem auto 0;
    aspect-ratio: 16 / 6;
    overflow: hidden;
    background: var(--midnight);
  }

  .area-photo-wrap--dual {
    display: flex;
    gap: 1.5rem;
    aspect-ratio: 16 / 6;
    background: var(--warm-white);
  }

  .area-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    flex-shrink: 0;
  }

  .area-photo-wrap--dual .area-photo {
    width: 50%;
    flex-shrink: 0;
    min-width: 0;
  }

  /* Chef's Counter: small left, wide right */
  #chefs-counter .area-photo:first-child {
    flex: 0 0 33%;
    width: 33%;
    object-position: center top;
  }
  #chefs-counter .area-photo:last-child {
    flex: 1 1 0;
    width: auto;
  }

  /* Bar & Salon: wide left, small right */
  #salon .area-photo:first-child {
    flex: 1 1 0;
    width: auto;
  }
  #salon .area-photo:last-child {
    flex: 0 0 33%;
    width: 33%;
    object-position: center top;
  }

  .area-photo-label {
    position: absolute;
    bottom: 2rem;
    left: 2.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .area-num {
    font-family: var(--font-header-action) sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.5);
  }

  .area-label {
    color: rgba(255, 255, 255, 0.5);
  }

  /* ── Body (text + sidebar) ── */
  .area-body {
    padding: 4rem 2.5rem;
  }

  .area-body-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  /* ── Title & description ── */
  .area-title {
    font-family: var(--font-headline);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 300;
    letter-spacing: 0.07em;
    color: var(--ink);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .area-desc {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
    margin-bottom: 2.5rem;
  }

  .area-desc p {
    font-family: var(--font-body) serif;
    font-size: var(--text-md);
    font-weight: 300;
    line-height: 1.55;
    color: var(--ink);
  }

  /* ── CTA ── */
  .area-cta {
    padding-top: 0;
  }

  .phone-reserve {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .phone-num {
    font-family: var(--font-body), serif;
    font-size: 1.375rem;
    font-weight: 300;
    letter-spacing: 0.04em;
  }

  .phone-num a {
    color: var(--midnight);
    text-decoration: none;
    border-bottom: 1px solid rgba(22, 34, 53, 0.25);
    transition: opacity 0.2s;
  }

  .phone-num a:hover {
    opacity: 0.5;
  }

  .phone-or {
    font-family: var(--font-header-action), sans-serif;
    font-size: 10px;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--charcoal);
  }

  /* ── Bottom photo ── */
  .area:last-of-type {
    border-bottom: none;
  }

  .area:last-of-type .area-body {
    padding-bottom: 1.5rem;
  }

  .bottom-photo-wrap {
    width: 80%;
    margin: 0 auto 2.5rem;
    aspect-ratio: 16 / 6;
    overflow: hidden;
  }

  .bottom-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* ── Responsive ── */
  @media (max-width: 860px) {
    .area-nav-link {
      padding: 1rem 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .area-photo-wrap {
      aspect-ratio: 4 / 3;
    }

    .area-body {
      padding: 3rem 1.5rem;
    }

    .area-nav {
      flex-direction: column;
    }

    .area-nav-link {
      border-right: none;
      border-bottom: 1px solid var(--border);
    }

    .area-nav-link:first-child {
      border-left: none;
    }
  }
</style>
