---
import { getSiteSettings } from "../lib/site-settings";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";

const restaurant = await getSiteSettings();
---

<Base
  title={`Careers — ${restaurant.name}`}
  description="Join the team at Urban Hearth. We're always looking for talented, passionate people."
>
  <div class="placeholder-page">
    <PageHeader
      eyebrow="Join the Team"
      title="Careers"
      lead="Details coming soon."
    />
    <div class="placeholder-body">
      <p>
        We're always looking for talented, passionate people. Reach out directly
        at <a href={`mailto:${restaurant.privateDiningEmail}`}
          >{restaurant.privateDiningEmail}</a
        >.
      </p>
    </div>
  </div>
</Base>

<style>
  .placeholder-page {
    margin-top: 103px;
  }

  .placeholder-body {
    max-width: 560px;
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
    text-align: center;
  }

  .placeholder-body p {
    font-family: var(--font-body), serif;
    font-size: var(--text-md);
    font-weight: 300;
    line-height: 1.8;
    color: var(--ink);
  }

  .placeholder-body a {
    color: inherit;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .placeholder-body a:hover {
    opacity: 0.6;
  }
</style>
