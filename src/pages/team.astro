---
import { getSiteSettings } from "../lib/site-settings";
import { isSanityConfigured } from "../lib/sanity";
import { fetchTeamMembers, fetchTeamPage } from "../lib/sanity-fetch";
import teamFallback from "../fallback-content/team.json";
import pageFallback from "../fallback-content/team-page.json";
import teamPhoto from "../assets/photos/team/Team.jpg";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";

const restaurant = await getSiteSettings();

let page: typeof pageFallback = pageFallback;
if (isSanityConfigured) {
  try {
    const data = await fetchTeamPage();
    if (data) page = { ...pageFallback, ...data };
  } catch (e) {
    console.error("Failed to fetch team page from Sanity:", e);
  }
}

let team: typeof teamFallback = teamFallback;
if (isSanityConfigured) {
  try {
    const fetched = await fetchTeamMembers();
    if (fetched?.length) team = fetched;
  } catch (e) {
    console.error("Failed to fetch team members from Sanity:", e);
  }
}
---

<Base title={`The Team — ${restaurant.name}`} description={page.seoDescription}>
  <div class="team-page">
    <PageHeader title={page.pageTitle} lead={page.pageLead} />

    <div class="team-banner">
      <img
        src={teamPhoto.src}
        alt="The Urban Hearth team"
        class="team-banner-img"
      />
    </div>

    <div class="team-list">
      {
        team.map((member) => (
          <article class="member">
            <div class="member-photo-wrap">
              {member.photo ? (
                <img
                  src={member.photo}
                  alt={member.name}
                  class="member-photo"
                />
              ) : (
                <div class="member-photo-placeholder" />
              )}
            </div>
            <div class="member-info">
              <p class="member-role">{member.roles[0]}</p>
              <h2 class="member-name">{member.name}</h2>
              <p class="member-bio">{member.bio}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .team-page {
    margin-top: 111px;
  }

  /* ── Team banner ── */
  .team-banner {
    max-width: 760px;
    margin: 0 auto 3rem;
    padding: 0 2.5rem;
  }

  .team-banner-img {
    width: 100%;
    display: block;
    object-fit: cover;
  }

  /* ── List ── */
  .team-list {
    max-width: 760px;
    margin: 0 auto 4rem;
    padding: 0 2.5rem;
    display: flex;
    flex-direction: column;
  }

  /* ── Member row ── */
  .member {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2.5rem;
    padding: 2.5rem 0;
    border-top: 1px solid var(--border);
    align-items: start;
  }

  .member:last-child {
    border-bottom: 1px solid var(--border);
  }

  /* ── Photo ── */
  .member-photo-wrap {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--parchment);
    flex-shrink: 0;
  }

  .member-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .member-photo-placeholder {
    width: 100%;
    height: 100%;
    background: var(--parchment);
  }

  /* ── Info ── */
  .member-info {
    display: flex;
    flex-direction: column;
    padding: 0.25rem 0;
  }

  .member-role {
    font-family: var(--font-header-action), sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mid);
    margin-bottom: 0.75rem;
  }

  .member-name {
    font-family: var(--font-body), serif;
    font-size: clamp(1.4rem, 2vw, 1.9rem);
    font-weight: 300;
    letter-spacing: 0.04em;
    color: var(--ink);
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  .member-bio {
    font-family: var(--font-header-action), sans-serif;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.85;
    color: var(--ink);
  }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .team-banner,
    .team-list {
      padding: 0 1.25rem;
    }

    .member {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .member-photo-wrap {
      aspect-ratio: 3 / 2;
    }
  }
</style>
