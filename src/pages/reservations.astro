---
import PageHeader from "../components/PageHeader.astro";
import { getSiteSettings } from "../lib/site-settings";
import { isSanityConfigured } from "../lib/sanity";
import {
  fetchReservationExperiences,
  fetchReservationsPage,
} from "../lib/sanity-fetch";
import reservationsFallback from "../fallback-content/reservations.json";
import pageFallback from "../fallback-content/reservations-page.json";
import Base from "../layouts/Base.astro";

const restaurant = await getSiteSettings();

let experiences = reservationsFallback;
let page = pageFallback;

if (isSanityConfigured) {
  try {
    const data = await fetchReservationExperiences();
    if (data?.length) experiences = data;
  } catch (e) {
    console.error("Failed to fetch reservation experiences from Sanity:", e);
  }
  try {
    const fetchedPage = await fetchReservationsPage();
    if (fetchedPage?.pageTitle) page = fetchedPage;
  } catch (e) {
    console.error("Failed to fetch reservations page from Sanity:", e);
  }
}
---

<Base
  title={`${page.pageTitle} — ${restaurant.name}`}
  description={page.seoDescription}
>
  <div class="reservations">
    <PageHeader title={page.pageTitle} lead={page.pageLead} />

    <div class="experiences">
      {
        experiences.slice(0, -1).map((exp) => (
          <div class="experience" id={exp.id}>
            <div class="exp-body">
              <h2 class="exp-title">{exp.title}</h2>
              <p class="exp-desc">{exp.description}</p>
              {exp.details.length > 0 && (
                <dl class="exp-details">
                  {exp.details.map((d) => (
                    <div>
                      <dt>{d.label}</dt>
                      <dd>
                        {d.linkType === "email" ? (
                          <a href={`mailto:${restaurant.privateDiningEmail}`}>
                            {restaurant.privateDiningEmail}
                          </a>
                        ) : d.linkType === "phone" ? (
                          <a
                            href={`tel:${restaurant.phone.replace(/\s/g, "")}`}
                          >
                            {restaurant.phone}
                          </a>
                        ) : (
                          d.value
                        )}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}
              {exp.note && <p class="exp-note">{exp.note}</p>}
            </div>
          </div>
        ))
      }
    </div>

    <div class="booking-cta">
      <a
        href={page.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="reserve-btn"
      >
        Reserve
      </a>
    </div>

    {
      experiences.slice(-1).map((exp) => (
        <div class="experience experience--walkin" id={exp.id}>
          <div class="exp-body">
            <h2 class="exp-title">{exp.title}</h2>
            <p class="exp-desc">{exp.description}</p>
            {exp.note && <p class="exp-note">{exp.note}</p>}
          </div>
        </div>
      ))
    }
  </div>
</Base>

<style>
  .reservations {
    margin-top: 103px;
  }

  /* ── Experience list ── */
  .experiences {
    max-width: 860px;
    margin: 0 auto;
    border-top: 1px solid var(--border);
  }

  .experience {
    padding: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .experience--walkin {
    background: var(--cream);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .exp-title {
    font-family: var(--font-body), serif;
    font-size: clamp(1.5rem, 2vw, 2rem);
    font-weight: 300;
    letter-spacing: 0.06em;
    color: var(--ink);
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .exp-desc {
    font-family: var(--font-body), serif;
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--ink);
    margin-bottom: 1.25rem;
    max-width: 52ch;
  }

  /* ── Details list ── */
  .exp-details {
    border-top: 1px solid var(--border);
    margin-bottom: 0;
  }

  .exp-details > div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .exp-details dt {
    font-family: var(--font-header-action), sans-serif;
    font-size: var(--text-label);
    font-weight: 300;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mid);
    padding-top: 2px;
  }

  .exp-details dd {
    font-family: var(--font-header-action), sans-serif;
    font-size: var(--text-sm);
    font-weight: 300;
    color: var(--ink);
    line-height: 1.5;
  }

  .exp-details dd a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition: opacity 0.2s;
  }

  .exp-details dd a:hover {
    opacity: 0.6;
  }

  .exp-note {
    font-family: var(--font-header-action), sans-serif;
    font-size: 12px;
    font-weight: 300;
    line-height: 1.75;
    font-style: italic;
    color: var(--ink-mid);
    margin-top: 1.5rem;
  }

  /* ── Single CTA ── */
  .booking-cta {
    max-width: 860px;
    margin: 0 auto;
    padding: 2rem 2rem 3rem;
    display: flex;
    justify-content: center;
  }

  .reserve-btn {
    display: inline-block;
    font-family: var(--font-header-action), sans-serif;
    font-size: var(--text-label);
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--warm-white);
    background: var(--midnight);
    padding: 1rem 2.5rem;
    min-width: 14rem;
    text-align: center;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .reserve-btn:hover {
    opacity: 0.75;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .experience {
      padding: 1.5rem;
    }

    .booking-cta {
      padding: 2rem 1.5rem;
    }
  }
</style>
