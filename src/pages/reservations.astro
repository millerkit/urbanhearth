---
import PageHeader from "../components/PageHeader.astro";
import { getSiteSettings } from "../lib/site-settings";
import { isSanityConfigured } from "../lib/sanity";
import {
  fetchReservationExperiences,
  fetchReservationsPage,
} from "../lib/sanity-fetch";
import reservationsFallback from "../fallback-content/reservations.json";
import pageFallback from "../fallback-content/reservations-page.json";
import diningOptionsFallback from "../fallback-content/dining-options.json";
import Base from "../layouts/Base.astro";

const restaurant = await getSiteSettings();

type Detail = { label: string; value?: string; linkType?: string };
type Experience = Omit<(typeof reservationsFallback)[number], "details"> & {
  details: Detail[];
};
let experiences: Experience[] = reservationsFallback as Experience[];
let page = pageFallback;

if (isSanityConfigured) {
  try {
    const data = await fetchReservationExperiences();
    if (data?.length) experiences = data;
  } catch (e) {
    console.error("Failed to fetch reservation experiences from Sanity:", e);
  }
  try {
    const fetchedPage = await fetchReservationsPage();
    if (fetchedPage?.pageTitle) page = { ...pageFallback, ...fetchedPage };
  } catch (e) {
    console.error("Failed to fetch reservations page from Sanity:", e);
  }
}

type DiningOption = (typeof diningOptionsFallback)[number];
let diningOptions: DiningOption[] = diningOptionsFallback;
if (isSanityConfigured) {
  try {
    const { fetchDiningOptions } = await import("../lib/sanity-fetch");
    const data = await fetchDiningOptions();
    if (data?.length) diningOptions = data;
  } catch (e) {
    console.error("Failed to fetch dining options from Sanity:", e);
  }
}
const diningOptionsMap = Object.fromEntries(
  diningOptions.map((o) => [o.id, o]),
);
---

<Base
  title={`${page.pageTitle} — ${restaurant.name}`}
  description={page.seoDescription}
>
  <div class="reservations">
    <PageHeader title={page.pageTitle} lead={page.pageLead} />

    <div class="experiences">
      {
        experiences.map((exp) => {
          const pricing = diningOptionsMap[exp.id];
          return (
            <div class="experience" id={exp.id}>
              <div class="exp-body">
                <h2 class="exp-title">{exp.title}</h2>
                {pricing?.price && (
                  <p class="exp-price">
                    {pricing.price}
                    <span class="exp-price-suffix"> {pricing.priceSuffix}</span>
                  </p>
                )}
                {pricing?.bookingNote && (
                  <p class="exp-booking-note">{pricing.bookingNote}</p>
                )}
                <div class="exp-desc">
                  {(
                    pricing?.descriptionShort ??
                    pricing?.description ??
                    []
                  ).map((para: string) => (
                    <p set:html={para} />
                  ))}
                  {exp.note && <p>{exp.note}</p>}
                </div>
                {exp.details.length > 0 && (
                  <dl class="exp-details">
                    {exp.details.map((d) => (
                      <div>
                        <dt>{d.label}</dt>
                        <dd>
                          {d.linkType === "email" ? (
                            <a href={`mailto:${restaurant.privateDiningEmail}`}>
                              {restaurant.privateDiningEmail}
                            </a>
                          ) : d.linkType === "phone" ? (
                            <a
                              href={`tel:${restaurant.phone.replace(/\s/g, "")}`}
                            >
                              {restaurant.phone}
                            </a>
                          ) : (
                            d.value
                          )}
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}
                {pricing?.pairings && pricing.pairings.length > 0 && (
                  <div class="exp-pairings">
                    <p class="exp-pairings-label">Optional pairings</p>
                    <ul class="exp-pairings-list">
                      {pricing.pairings.map((p) => (
                        <li class="exp-pairing-row">
                          <span class="exp-pairing-name">{p.label}</span>
                          <span class="exp-pairing-price">{p.price}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                <div class="exp-cta">
                  {exp.id === "chefs-counter" ? (
                    <a
                      href={
                        page.chefCounterBookingUrl ??
                        page.bookingUrl ??
                        restaurant.reservations.href
                      }
                      target="_blank"
                      rel="noopener noreferrer"
                      class="reserve-btn"
                    >
                      Reserve a Seat
                    </a>
                  ) : (
                    <div class="ot-widget-container">
                      <script
                        is:inline
                        type="text/javascript"
                        src="//www.opentable.com/widget/reservation/loader?rid=342889&type=standard&theme=wide&color=8&dark=false&iframe=true&domain=com&lang=en-US&newtab=false&ot_source=Restaurant%20website&font=trebuchetMs&ot_logo=standard&primary_color=ffffff&primary_font_color=333333&button_color=162235&button_font_color=ffffff&logo_pid=95007913&cfe=true"
                      />
                    </div>
                  )}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</Base>

<style>
  .reservations {
    margin-top: 111px;
  }

  /* ── Experience list ── */
  .experiences {
    max-width: 936px;
    margin: 0 auto;
    border-top: 1px solid var(--border);
  }

  .experience {
    padding: 1.75rem 2rem;
    border-bottom: 1px solid var(--border);
  }

  .exp-title {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 2vw, 2rem);
    font-weight: 300;
    letter-spacing: 0.06em;
    color: var(--ink);
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .exp-price {
    font-family: var(--font-body), serif;
    font-size: 1.75rem;
    font-weight: 300;
    color: var(--midnight);
    line-height: 1;
    margin-bottom: 0.4rem;
  }

  .exp-price-suffix {
    font-family: var(--font-header-action), sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: var(--ink-mid);
  }

  .exp-booking-note {
    font-family: var(--font-header-action), sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: var(--ink-mid);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .exp-desc {
    font-family: var(--font-body), serif;
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--ink);
    margin-bottom: 1.25rem;
  }

  .exp-desc p + p {
    margin-top: 1.25rem;
  }

  .exp-pairings {
    margin-top: 1.25rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .exp-pairings-label {
    font-family: var(--font-header-action), sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mid);
    margin-bottom: 0.6rem;
  }

  .exp-pairings-list {
    list-style: none;
  }

  .exp-pairing-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .exp-pairing-name {
    font-family: var(--font-body), serif;
    font-size: var(--text-base);
    font-weight: 300;
    color: var(--ink);
  }

  .exp-pairing-price {
    font-family: var(--font-header-action), sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: var(--ink);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ── Details list ── */
  .exp-details {
    border-top: 1px solid var(--border);
    margin-bottom: 0;
  }

  .exp-details > div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .exp-details dt {
    font-family: var(--font-header-action), sans-serif;
    font-size: var(--text-label);
    font-weight: 300;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mid);
    padding-top: 2px;
  }

  .exp-details dd {
    font-family: var(--font-header-action), sans-serif;
    font-size: var(--text-sm);
    font-weight: 300;
    color: var(--ink);
    line-height: 1.5;
  }

  .exp-details dd a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition: opacity 0.2s;
  }

  .exp-details dd a:hover {
    opacity: 0.6;
  }

  /* ── Per-experience CTA ── */
  .exp-cta {
    margin-top: 1rem;
    display: flex;
    justify-content: flex-end;
  }

  .reserve-btn {
    display: block;
    width: 100%;
    font-family: var(--font-header-action), sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--warm-white);
    background: var(--midnight);
    border: none;
    padding: 1.4rem 2rem;
    text-align: center;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .reserve-btn:hover {
    opacity: 0.75;
  }

  .ot-widget-container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-height: 130px;
    overflow: visible;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .experience {
      padding: 1.5rem;
    }

    .booking-cta {
      padding: 2rem 1.5rem;
    }

    .ot-widget-container {
      max-height: 320px;
      display: flex;
      justify-content: center;
    }
  }
</style>
