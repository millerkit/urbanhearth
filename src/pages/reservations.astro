---
import PageHeader from "../components/PageHeader.astro";
import { getSiteSettings } from "../lib/site-settings";
import { isSanityConfigured } from "../lib/sanity";
import {
  fetchReservationExperiences,
  fetchReservationsPage,
} from "../lib/sanity-fetch";
import reservationsFallback from "../fallback-content/reservations.json";
import pageFallback from "../fallback-content/reservations-page.json";
import Base from "../layouts/Base.astro";

const restaurant = await getSiteSettings();

let experiences = reservationsFallback;
let page = pageFallback;

if (isSanityConfigured) {
  try {
    const data = await fetchReservationExperiences();
    if (data?.length) experiences = data;
  } catch (e) {
    console.error("Failed to fetch reservation experiences from Sanity:", e);
  }
  try {
    const fetchedPage = await fetchReservationsPage();
    if (fetchedPage?.pageTitle) page = fetchedPage;
  } catch (e) {
    console.error("Failed to fetch reservations page from Sanity:", e);
  }
}
---

<Base
  title={`${page.pageTitle} — ${restaurant.name}`}
  description={page.seoDescription}
>
  <div class="reservations">
    <PageHeader title={page.pageTitle} lead={page.pageLead} />

    <div class="experiences">
      {
        experiences.map((exp) => (
          <div class="experience" id={exp.id}>
            <div class="exp-body">
              <h2 class="exp-title">{exp.title}</h2>
              <p class="exp-desc">
                {exp.description}
                {exp.note && ` ${exp.note}`}
              </p>
              {exp.details.length > 0 && (
                <dl class="exp-details">
                  {exp.details.map((d) => (
                    <div>
                      <dt>{d.label}</dt>
                      <dd>
                        {d.linkType === "email" ? (
                          <a href={`mailto:${restaurant.privateDiningEmail}`}>
                            {restaurant.privateDiningEmail}
                          </a>
                        ) : d.linkType === "phone" ? (
                          <a
                            href={`tel:${restaurant.phone.replace(/\s/g, "")}`}
                          >
                            {restaurant.phone}
                          </a>
                        ) : (
                          d.value
                        )}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <div class="booking-cta">
      <p class="booking-cta-label">Reserve either experience</p>
      <button class="reserve-btn" id="open-reservation-modal">Reserve</button>
    </div>
  </div>

  <div
    class="modal-overlay"
    id="reservation-modal"
    role="dialog"
    aria-modal="true"
    aria-label="Make a reservation"
  >
    <div class="modal-box">
      <button
        class="modal-close"
        id="close-reservation-modal"
        aria-label="Close">&#x2715;</button
      >
      <iframe
        src={`https://www.opentable.com/widget/reservation/loader?rid=342889&domain=com&type=standard&theme=standard&lang=en-US&ot_source=Restaurant%20website&iframe=true`}
        width="100%"
        height="100%"
        frameborder="0"
        scrolling="yes"
        title="Make a reservation"></iframe>
    </div>
  </div>
</Base>

<style>
  .reservations {
    margin-top: 111px;
  }

  /* ── Experience list ── */
  .experiences {
    max-width: 860px;
    margin: 0 auto;
    border-top: 1px solid var(--border);
  }

  .experience {
    padding: 1.25rem 2rem;
    border-bottom: 1px solid var(--border);
  }

  .exp-title {
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 2vw, 2rem);
    font-weight: 300;
    letter-spacing: 0.06em;
    color: var(--ink);
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .exp-desc {
    font-family: var(--font-body), serif;
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--ink);
    margin-bottom: 1.25rem;
  }

  /* ── Details list ── */
  .exp-details {
    border-top: 1px solid var(--border);
    margin-bottom: 0;
  }

  .exp-details > div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .exp-details dt {
    font-family: var(--font-header-action), sans-serif;
    font-size: var(--text-label);
    font-weight: 300;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mid);
    padding-top: 2px;
  }

  .exp-details dd {
    font-family: var(--font-header-action), sans-serif;
    font-size: var(--text-sm);
    font-weight: 300;
    color: var(--ink);
    line-height: 1.5;
  }

  .exp-details dd a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition: opacity 0.2s;
  }

  .exp-details dd a:hover {
    opacity: 0.6;
  }

  /* ── Single CTA ── */
  .booking-cta-label {
    font-family: var(--font-header-action), sans-serif;
    font-size: var(--text-label);
    font-weight: 300;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mid);
    text-align: center;
    margin-bottom: 1rem;
  }

  .booking-cta {
    max-width: 860px;
    margin: 0 auto;
    padding: 2rem 2rem 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .reserve-btn {
    display: inline-block;
    font-family: var(--font-header-action), sans-serif;
    font-size: var(--text-label);
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--warm-white);
    background: var(--midnight);
    padding: 1rem 2.5rem;
    min-width: 14rem;
    text-align: center;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .reserve-btn:hover {
    opacity: 0.75;
  }

  /* ── Modal ── */
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .modal-overlay.is-open {
    display: flex;
  }

  .modal-box {
    position: relative;
    width: 100%;
    max-width: 540px;
    height: min(680px, 90vh);
    background: #fff;
  }

  .modal-box iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: none;
  }

  .modal-close {
    position: absolute;
    top: -2.25rem;
    right: 0;
    background: none;
    border: none;
    color: #fff;
    font-size: 1.25rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.25rem 0.5rem;
    opacity: 0.8;
    transition: opacity 0.2s;
  }

  .modal-close:hover {
    opacity: 1;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .experience {
      padding: 1.5rem;
    }

    .booking-cta {
      padding: 2rem 1.5rem;
    }

    .modal-box {
      height: 85vh;
    }
  }
</style>

<script>
  const modal = document.getElementById("reservation-modal")!;
  const openBtn = document.getElementById("open-reservation-modal")!;
  const closeBtn = document.getElementById("close-reservation-modal")!;

  openBtn.addEventListener("click", () => {
    modal.classList.add("is-open");
    document.body.style.overflow = "hidden";
  });

  const closeModal = () => {
    modal.classList.remove("is-open");
    document.body.style.overflow = "";
  };

  closeBtn.addEventListener("click", closeModal);

  modal.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });
</script>
