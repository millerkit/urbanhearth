---
import { getSiteSettings } from "../lib/site-settings";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";

const restaurant = await getSiteSettings();

const GIFT_CARD_URL =
  "https://order.toasttab.com/egiftcards/urban-hearth-inman-square";
---

<Base
  title={`Gift Cards — ${restaurant.name}`}
  description="Give the gift of a great meal. Urban Hearth gift cards are available for any occasion."
>
  <div class="gift-card-page">
    <PageHeader title="Gift Cards" />
    <div class="gift-card-body">
      <p>
        Share the gift of a special night out at Urban Hearth — we offer
        physical gift cards available in house, or purchase an e-gift card
        online to send instantly. Not sure how much to give? We suggest $85 per
        person for our à la carte dinner, or $160 per person for the Chef's
        Counter experience.
      </p>
      <a
        href={GIFT_CARD_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="gift-card-btn"
      >
        Purchase an E-Gift Card
      </a>
    </div>
  </div>
</Base>

<style>
  .gift-card-page {
    margin-top: 111px;
  }

  .gift-card-page :global(.page-header) {
    padding-bottom: 1.25rem;
  }

  .gift-card-body {
    max-width: 560px;
    margin: 0 auto;
    padding: 2rem 2rem 6rem;
    text-align: center;
  }

  .gift-card-body p {
    font-family: var(--font-body), serif;
    font-size: var(--text-lg);
    font-weight: 300;
    line-height: 1.8;
    color: var(--ink);
    margin-bottom: 2.5rem;
  }

  .gift-card-btn {
    display: inline-block;
    font-family: var(--font-header-action), sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    background: var(--midnight);
    padding: 1.4rem 2.5rem;
    text-align: center;
    transition: opacity 0.2s;
  }

  .gift-card-btn:hover {
    opacity: 0.75;
  }
</style>
