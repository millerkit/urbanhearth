---
import { getSiteSettings } from "../lib/site-settings";
import { isSanityConfigured } from "../lib/sanity";
import { fetchChefProfile } from "../lib/sanity-fetch";
import chefFallback from "../fallback-content/chef.json";
import page from "../fallback-content/chef-page.json";
import erinFallbackPhoto from "../assets/photos/ChefErinHeadshot.webp";
import Base from "../layouts/Base.astro";
import ReservationButton from "../components/ReservationButton.astro";

const restaurant = await getSiteSettings();

let chef = chefFallback;
if (isSanityConfigured) {
  try {
    const data = await fetchChefProfile();
    if (data) chef = data;
  } catch (e) {
    console.error("Failed to fetch chef profile from Sanity:", e);
  }
}

const photoSrc = chef.photo ?? erinFallbackPhoto.src;
---

<Base
  title={`${chef.name} — ${restaurant.name}`}
  description={page.seoDescription}
>
  <div class="chef-page">
    <div class="chef-layout">
      <div class="chef-heading">
        <div class="chef-eyebrow">
          <p class="section-eyebrow">{chef.title}</p>
        </div>

        <h1 class="chef-name">{chef.name}</h1>

        {
          chef.roles.length > 0 && (
            <div class="chef-roles">
              {chef.roles.map((role, i) => (
                <>
                  <span>{role}</span>
                  {i < chef.roles.length - 1 && <span class="role-dot">·</span>}
                </>
              ))}
            </div>
          )
        }
      </div>

      <div class="chef-photo-col">
        <div class="chef-photo-wrap">
          <img src={photoSrc} alt={chef.name} class="chef-photo" />
        </div>
      </div>

      <div class="chef-content-col">
        <div class="chef-bio">
          {chef.bio.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="chef-accolades">
          {
            chef.accolades.map((a) => (
              <div class="accolade">
                <span class="accolade-year">{a.year}</span>
                <span class="accolade-text">{a.text}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .chef-page {
    margin-top: 111px;
    min-height: calc(100vh - 111px);
    display: flex;
    flex-direction: column;
  }

  /* ── Layout ── */
  .chef-layout {
    max-width: 860px;
    margin: 0 auto 4rem;
    padding: 3rem 2rem 0;
  }

  /* ── Heading ── */
  .chef-heading {
    margin-bottom: 1.5rem;
  }

  /* ── Eyebrow ── */
  .chef-eyebrow {
    margin-bottom: 1.8rem;
  }

  /* ── Name ── */
  .chef-name {
    font-family: var(--font-headline);
    font-size: clamp(2.8rem, 3.6vw, 4.2rem);
    font-weight: 300;
    letter-spacing: 0.08em;
    color: var(--ink);
    line-height: 1.05;
    margin-bottom: 1.1rem;
  }

  /* ── Roles ── */
  .chef-roles {
    font-family: var(--font-header-action) sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-light);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .role-dot {
    color: var(--border);
  }

  /* ── Photo ── */
  .chef-photo-col {
    margin-bottom: 1rem;
  }

  .chef-photo-wrap {
    width: 100%;
  }

  .chef-photo {
    width: 100%;
    height: auto;
    display: block;
    opacity: 0.92;
  }

  /* ── Content ── */
  .chef-content-col {
    padding-top: 2rem;
  }

  /* ── Bio ── */
  .chef-bio {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    margin-bottom: 3rem;
  }

  .chef-bio p {
    font-family: var(--font-body) serif;
    font-size: var(--text-md);
    font-weight: 300;
    line-height: 1.85;
    color: var(--ink);
  }

  /* ── Accolades ── */
  .chef-accolades {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 3rem;
    border-top: 1px solid var(--border);
  }

  .accolade {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }

  .accolade-year {
    font-family: var(--font-header-action) sans-serif;
    font-size: var(--text-label);
    font-weight: 300;
    letter-spacing: 0.14em;
    color: var(--ink-mid);
  }

  .accolade-text {
    font-family: var(--font-header-action) sans-serif;
    font-size: 14px;
    font-weight: 300;
    color: var(--ink);
    letter-spacing: 0.02em;
  }

  /* ── CTA ── */
  .chef-cta {
    padding-top: 0.5rem;
  }

  @media (max-width: 600px) {
    .chef-layout {
      padding: 0 1.25rem;
    }

    .chef-bio p {
      font-size: 1.0625rem;
    }
  }
</style>
