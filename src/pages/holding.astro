---
import logo from "../assets/brand/UrbanHearth_Logo.png";
import charcoal from "../assets/charcoal/Charcoal_art_5.jpg";
import instagramGlyph from "../assets/ui/Instagram_Glyph_Black.jpg";
import michelinSeal from "../assets/ui/michelin-selected.png";
import jamesBeardSeal from "../assets/ui/james-beard-seal.png";
import restaurant from "../content/restaurant.json";

const reservationHref = "https://www.opentable.com/r/urban-hearth-cambridge";
const instagramHref = "https://www.instagram.com/urban_hearth";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Urban Hearth — Cambridge, MA</title>
    <meta name="description" content={restaurant.tagline} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:ital,wght@0,200;0,300;0,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <img src={charcoal.src} alt="" class="charcoal-bg" />
    <aside class="site-info">
      <span>1281 Cambridge St</span>
      <a href="tel:6176827295">617 682 7295</a>
    </aside>
    <main>
      <div class="splash-block">
        <img src={logo.src} alt="Urban Hearth" class="splash-logo" />
        <p class="splash-location">
          <span>Inman Square&nbsp;&nbsp;|&nbsp;&nbsp;Cambridge</span>
        </p>
      </div>
      <a
        href={reservationHref}
        class="reservation-link"
        target="_blank"
        rel="noopener noreferrer">Reserve</a
      >
    </main>

    <footer>
      <a
        href={instagramHref}
        class="instagram-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Urban Hearth on Instagram"
      >
        <img src={instagramGlyph.src} alt="" class="instagram-glyph" />
      </a>
      <div class="foot-center">
        <button id="learn-trigger" class="learn-btn">Learn</button>
        <form id="signup-form" class="signup-form" novalidate hidden>
          <label>
            <input
              type="text"
              name="first_name"
              placeholder="First"
              required
              class="signup-input"
              autocomplete="given-name"
            />
          </label>
          <label>
            <input
              type="text"
              name="last_name"
              placeholder="Last"
              required
              class="signup-input"
              autocomplete="family-name"
            />
          </label>
          <label>
            <input
              type="email"
              name="email"
              placeholder="Email"
              required
              class="signup-input signup-input--email"
              autocomplete="email"
            />
          </label>
          <button type="submit" class="signup-submit" aria-label="Subscribe"
            >→</button
          >
        </form>
        <p id="signup-thanks" class="signup-thanks" hidden>Thank you</p>
      </div>
      <div class="foot-right">
        <a
          href="https://guide.michelin.com/us/en/massachusetts/cambridge_2914793/restaurant/urban-hearth"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Michelin Selected 2025"
        >
          <img src={michelinSeal.src} alt="" class="footer-seal" />
        </a>
        <a
          href="https://www.jamesbeard.org/stories/2025-james-beard-awards-restaurant-and-chef-nominees"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="James Beard Foundation Nominee 2025"
        >
          <img
            src={jamesBeardSeal.src}
            alt=""
            class="footer-seal footer-seal--jb"
          />
        </a>
        <a href="mailto:press@urbanhearth.net" class="press-link"
          >Media Inquiries</a
        >
      </div>
    </footer>
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  [hidden] {
    display: none !important;
  }

  :root {
    --parchment: #e8e3df;
    --midnight: #162235;
    --charcoal: #706f6d;
    --font-header-action: "DM Sans", sans-serif;
  }

  html,
  body {
    height: 100%;
  }

  body {
    background: var(--parchment);
    color: var(--midnight);
    font-family: var(--font-header-action), sans-serif;
    -webkit-font-smoothing: antialiased;
    min-height: 100dvh;
  }

  .charcoal-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    mix-blend-mode: multiply;
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
  }

  .splash-block {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .splash-logo {
    width: min(320px, 58vw);
    height: auto;
    display: block;
    mix-blend-mode: multiply;
    filter: contrast(1.4);
  }

  .splash-location {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin-top: -6rem;
  }

  .splash-location span {
    font-family: var(--font-header-action), sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--charcoal);
  }

  .site-info {
    position: fixed;
    top: 1.5rem;
    right: 2rem;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .site-info span,
  .site-info a {
    font-family: var(--font-header-action), sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--midnight);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .site-info a:hover {
    opacity: 0.5;
  }

  @media (max-width: 900px) {
    .site-info {
      display: none;
    }
  }

  main {
    position: relative;
    z-index: 1;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3rem;
  }

  .footer-seal {
    display: block;
    width: 64px;
    height: 64px;
    object-fit: contain;
    mix-blend-mode: multiply;
    opacity: 0.85;
    transition: opacity 0.2s;
  }

  .footer-seal--jb {
    width: 80px;
    height: 80px;
  }

  .footer-seal:hover {
    opacity: 0.6;
  }

  .reservation-link {
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--midnight);
    text-decoration: none;
    border-bottom: 1px solid var(--midnight);
    padding-bottom: 3px;
    margin-top: 14vh;
    transition: opacity 0.2s;
  }

  .reservation-link:hover {
    opacity: 0.5;
  }

  footer {
    position: fixed;
    bottom: 2rem;
    left: 2rem;
    right: 2rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    z-index: 1;
  }

  .foot-center {
    display: flex;
    justify-content: center;
  }

  .foot-right {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.25rem;
  }

  .press-link {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--midnight);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .press-link:hover {
    opacity: 0.5;
  }

  .instagram-link {
    display: block;
    color: var(--midnight);
    transition: opacity 0.2s;
  }

  .instagram-link:hover {
    opacity: 0.5;
  }

  .instagram-glyph {
    display: block;
    width: 22px;
    height: 22px;
    mix-blend-mode: multiply;
  }

  .learn-btn {
    font-family: var(--font-header-action);
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--midnight);
    background: var(--parchment);
    border: 1px solid var(--midnight);
    padding: 0.55rem 1.1rem;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .learn-btn:hover {
    opacity: 0.6;
  }

  .signup-form {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
  }

  .signup-input {
    font-family: var(--font-header-action);
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.1em;
    color: var(--midnight);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--midnight);
    padding: 0.25rem 0;
    width: 96px;
    outline: none;
  }

  .signup-input--email {
    width: 180px;
  }

  .signup-input::placeholder {
    color: var(--midnight);
    opacity: 0.45;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .signup-submit {
    font-family: var(--font-header-action);
    font-size: 13px;
    background: var(--midnight);
    border: 1px solid var(--midnight);
    color: var(--parchment);
    cursor: pointer;
    padding: 0.35rem 0.7rem;
    line-height: 1;
    transition: opacity 0.2s;
  }

  .signup-submit:hover {
    opacity: 0.7;
  }

  .signup-thanks {
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--midnight);
  }

  @media (max-width: 600px) {
    footer {
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
      gap: 1.25rem;
    }

    .foot-center {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }

    .signup-form {
      flex-wrap: wrap;
      gap: 0.6rem 0.75rem;
    }

    .signup-input--email {
      width: 160px;
    }
  }
</style>

<script>
  const trigger = document.getElementById("learn-trigger") as HTMLButtonElement;
  const form = document.getElementById("signup-form") as HTMLFormElement;
  const thanks = document.getElementById("signup-thanks") as HTMLElement;

  trigger.addEventListener("click", () => {
    trigger.hidden = true;
    form.hidden = false;
    (form.querySelector("input") as HTMLInputElement).focus();
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    try {
      const res = await fetch("https://formspree.io/f/meeddqvl", {
        method: "POST",
        body: data,
        headers: { Accept: "application/json" },
      });
      if (res.ok) {
        form.hidden = true;
        thanks.hidden = false;
      }
    } catch {
      // silent fail — form stays visible so visitor can retry
    }
  });
</script>
