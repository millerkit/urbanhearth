---
import logo from "../assets/brand/UrbanHearth_Logo.png";
import charcoal from "../assets/charcoal/Charcoal_art_5.jpg";
import michelinSeal from "../assets/ui/michelin_selected_2025_Round_Black.png";
import jamesBeardSeal from "../assets/ui/james-beard-seal.png";
import restaurant from "../content/restaurant.json";

const reservationHref = "https://www.opentable.com/r/urban-hearth-cambridge";
const instagramHref = "https://www.instagram.com/urban_hearth";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Urban Hearth — Cambridge, MA</title>
    <meta name="description" content={restaurant.tagline} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:ital,wght@0,200;0,300;0,400&display=swap"
      rel="stylesheet"
    />
    <!-- Fathom - beautiful, simple website analytics -->
    <script src="https://cdn.usefathom.com/script.js" data-site="NZMAWAWM" defer
    ></script>
    <!-- / Fathom -->
  </head>
  <body>
    <img src={charcoal.src} alt="" class="charcoal-bg" />
    <aside class="site-info">
      <span>1281 Cambridge St</span>
      <a href="tel:6176827295">617 682 7295</a>
    </aside>
    <div class="top-left">
      <button id="learn-trigger" class="learn-btn">Learn</button>
      <form id="signup-form" class="signup-form" novalidate hidden>
        <label>
          <input
            type="text"
            name="first_name"
            placeholder="First"
            required
            class="signup-input"
            autocomplete="given-name"
          />
        </label>
        <label>
          <input
            type="text"
            name="last_name"
            placeholder="Last"
            required
            class="signup-input"
            autocomplete="family-name"
          />
        </label>
        <label>
          <input
            type="email"
            name="email"
            placeholder="Email"
            required
            class="signup-input signup-input--email"
            autocomplete="email"
          />
        </label>
        <button type="submit" class="signup-submit" aria-label="Subscribe"
          >→</button
        >
        <p id="signup-error" class="signup-error" hidden>
          Please fill out all fields
        </p>
      </form>
      <p id="signup-thanks" class="signup-thanks" hidden>Thank you</p>
    </div>
    <main>
      <div class="splash-block">
        <img src={logo.src} alt="Urban Hearth" class="splash-logo" />
        <p class="splash-location">
          <span>Inman Square&nbsp;&nbsp;|&nbsp;&nbsp;Cambridge</span>
        </p>
      </div>
      <a
        href={reservationHref}
        class="reservation-link"
        target="_blank"
        rel="noopener noreferrer">Reserve</a
      >
    </main>

    <footer>
      <div class="foot-contact">
        <span>1281 Cambridge St</span>
        <a href="tel:6176827295">617 682 7295</a>
      </div>
      <div class="foot-mid">
        <a
          href={instagramHref}
          class="instagram-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Urban Hearth on Instagram"
        >
          <svg
            class="instagram-glyph"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"
            ></path>
          </svg>
        </a>
        <a href="mailto:press@urbanhearth.net" class="press-link"
          >Media Inquiries</a
        >
      </div>

      <div class="foot-right">
        <a
          href="https://guide.michelin.com/us/en/massachusetts/cambridge_2914793/restaurant/urban-hearth"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Michelin Selected 2025"
        >
          <img src={michelinSeal.src} alt="" class="footer-seal" />
        </a>
        <a
          href="https://www.jamesbeard.org/stories/2025-james-beard-awards-restaurant-and-chef-nominees"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="James Beard Foundation Nominee 2025"
        >
          <img
            src={jamesBeardSeal.src}
            alt=""
            class="footer-seal footer-seal--jb"
          />
        </a>
      </div>
    </footer>
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  [hidden] {
    display: none !important;
  }

  :root {
    --parchment: #e8e3df;
    --midnight: #162235;
    --charcoal: #706f6d;
    --font-header-action: "DM Sans", sans-serif;
  }

  html,
  body {
    height: 100%;
  }

  body {
    background: var(--parchment);
    color: var(--charcoal);
    font-family: var(--font-header-action), sans-serif;
    -webkit-font-smoothing: antialiased;
    min-height: 100dvh;
  }

  .charcoal-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    mix-blend-mode: multiply;
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
  }

  .splash-block {
    position: fixed;
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 1;
  }

  .splash-logo {
    width: min(320px, 58vw);
    height: auto;
    display: block;
    mix-blend-mode: multiply;
    filter: contrast(1.4);
  }

  .splash-location {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin-top: -6rem;
  }

  .splash-location span {
    font-family: var(--font-header-action), sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--charcoal);
  }

  .site-info {
    position: fixed;
    top: 1.5rem;
    right: 2rem;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .site-info span,
  .site-info a {
    font-family: var(--font-header-action), sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--charcoal);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .site-info a:hover {
    opacity: 0.5;
  }

  @media (max-width: 900px) {
    .site-info {
      display: none;
    }
  }

  main {
    position: relative;
    z-index: 1;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer-seal {
    display: block;
    width: 64px;
    height: 64px;
    object-fit: contain;
    mix-blend-mode: multiply;
    opacity: 0.85;
    transition: opacity 0.2s;
  }

  .footer-seal--jb {
    width: 80px;
    height: 80px;
  }

  .footer-seal:hover {
    opacity: 0.6;
  }

  .reservation-link {
    position: fixed;
    top: 60%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--charcoal);
    text-decoration: none;
    border-bottom: 1px solid var(--charcoal);
    padding-bottom: 3px;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .reservation-link:hover {
    opacity: 0.5;
  }

  .top-left {
    position: fixed;
    top: 1.5rem;
    left: 2rem;
    z-index: 2;
    display: flex;
    align-items: center;
  }

  footer {
    position: fixed;
    bottom: 2rem;
    left: 4rem;
    right: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 1;
  }

  .foot-mid {
    display: contents;
  }

  .foot-right {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.65rem;
  }

  .press-link {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--charcoal);
    text-decoration: none;
    transition: opacity 0.2s;
    position: absolute;
    left: 49%;
    transform: translateX(-50%);
  }

  .press-link:hover {
    opacity: 0.5;
  }

  .instagram-link {
    display: block;
    color: var(--charcoal);
    transition: opacity 0.2s;
  }

  .instagram-link:hover {
    opacity: 0.5;
  }

  .instagram-glyph {
    display: block;
    width: 28px;
    height: 28px;
    fill: var(--charcoal);
  }

  .learn-btn {
    font-family: var(--font-header-action), sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--charcoal);
    background: var(--parchment);
    border: 1px solid var(--charcoal);
    padding: 0.55rem 1.1rem;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .learn-btn:hover {
    opacity: 0.6;
  }

  .signup-form {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
  }

  .signup-input {
    font-family: var(--font-header-action), sans-serif;
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.1em;
    color: var(--charcoal);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--midnight);
    padding: 0.25rem 0;
    width: 96px;
    outline: none;
  }

  .signup-input--email {
    width: 180px;
  }

  .signup-input--error {
    border-bottom-color: #c0392b;
  }

  .signup-error {
    font-family: var(--font-header-action), sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.08em;
    color: #c0392b;
    text-transform: uppercase;
    margin: 0.4rem 0 0;
    text-align: center;
    width: 100%;
  }

  .signup-input::placeholder {
    color: var(--midnight);
    opacity: 0.45;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .signup-submit {
    font-family: var(--font-header-action), sans-serif;
    font-size: 13px;
    background: var(--midnight);
    border: 1px solid var(--midnight);
    color: var(--parchment);
    cursor: pointer;
    padding: 0.35rem 0.7rem;
    line-height: 1;
    transition: opacity 0.2s;
  }

  .signup-submit:hover {
    opacity: 0.7;
  }

  .signup-thanks {
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--midnight);
  }

  .foot-contact {
    display: none;
  }

  @media (max-width: 600px) {
    .top-left {
      left: 50%;
      transform: translateX(-50%);
      justify-content: center;
    }

    .splash-block {
      top: 30%;
    }

    .splash-location {
      margin-top: -3rem;
    }

    .splash-location span {
      white-space: nowrap;
      font-size: 9px;
    }

    footer {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      bottom: 1.5rem;
      left: 2rem;
      right: 2rem;
    }

    .foot-contact {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      font-family: var(--font-header-action), sans-serif;
      font-size: 10px;
      font-weight: 300;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--charcoal);
    }

    .foot-contact a {
      color: var(--charcoal);
      text-decoration: none;
    }

    .foot-mid {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .press-link {
      position: static;
      transform: none;
    }

    .foot-right {
      justify-content: center;
    }

    .foot-center {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }

    .signup-form {
      flex-wrap: wrap;
      gap: 0.6rem 0.75rem;
      justify-content: center;
    }

    .signup-input {
      text-align: center;
    }

    .signup-input--email {
      width: 160px;
    }
  }
</style>

<script>
  const trigger = document.getElementById("learn-trigger") as HTMLButtonElement;
  const form = document.getElementById("signup-form") as HTMLFormElement;
  const thanks = document.getElementById("signup-thanks") as HTMLElement;
  const errorMsg = document.getElementById("signup-error") as HTMLElement;

  trigger.addEventListener("click", () => {
    trigger.hidden = true;
    form.hidden = false;
    (form.querySelector("input") as HTMLInputElement).focus();
  });

  form.querySelectorAll("input").forEach((input) => {
    input.addEventListener("input", () => {
      input.classList.remove("signup-input--error");
      errorMsg.hidden = true;
    });
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const inputs = form.querySelectorAll(
      "input[required]",
    ) as NodeListOf<HTMLInputElement>;
    let firstInvalid: HTMLInputElement | null = null;
    for (const input of inputs) {
      const empty = !input.value.trim();
      const badEmail =
        input.type === "email" && input.value.trim() && !input.validity.valid;
      if (empty || badEmail) {
        input.classList.add("signup-input--error");
        if (!firstInvalid) firstInvalid = input;
      } else {
        input.classList.remove("signup-input--error");
      }
    }
    if (firstInvalid) {
      errorMsg.hidden = false;
      firstInvalid.focus();
      return;
    }
    errorMsg.hidden = true;
    const data = new FormData(form);
    try {
      const res = await fetch("https://formspree.io/f/meeddqvl", {
        method: "POST",
        body: data,
        headers: { Accept: "application/json" },
      });
      if (res.ok) {
        form.hidden = true;
        thanks.hidden = false;
      }
    } catch {
      // silent fail — form stays visible so visitor can retry
    }
  });
</script>
