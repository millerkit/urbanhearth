---
import "../styles/global.css";
import "../styles/cart.css";
import contaxSansUrl from "../assets/fonts/ContaxSans35Thin.woff2?url";
import akzidenzUrl from "../assets/fonts/AkzidenzGroteskW1GLight.woff2?url";
import { getSiteSettings } from "../lib/site-settings";
import TopBar from "../components/TopBar.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer";

const restaurant = await getSiteSettings();

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
}

const {
  title = `${restaurant.name} — Cambridge, MA`,
  description = restaurant.tagline,
  ogImage = `${restaurant.url}/og-image.jpg`,
  ogType = "website",
} = Astro.props;

// Normalize the canonical path to the no-slash form (matching how every
// internal link is written) so /about and /about/ declare the same canonical
// URL. This lets Google consolidate the trailing-slash duplicates without a
// redirect — deliberately avoiding the Cloudflare asset-layer redirect that
// broke the nav twice (see TESTING.md / the 2026-07 incidents).
const normalizedPath =
  Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/+$/, "");
const canonicalURL = new URL(normalizedPath, Astro.site ?? restaurant.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <!-- Preload display fonts to prevent FOUT on headline elements -->
    <link
      rel="preload"
      href={contaxSansUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={akzidenzUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={restaurant.name} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter Card -->
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fathom - beautiful, simple website analytics -->
    <script src="https://cdn.usefathom.com/script.js" data-site="NZMAWAWM" defer
    ></script>
    <!-- / Fathom -->
    <script is:inline>
      // Fathom custom events: Reserve links and the large-parties inquiry.
      window.trackEvent = function (name) {
        try {
          if (window.fathom) window.fathom.trackEvent(name);
        } catch (_) {}
      };
      document.addEventListener("click", function (e) {
        var el = e.target.closest && e.target.closest("a, button");
        if (!el) return;
        if (el.classList.contains("js-open-inquiry")) {
          window.trackEvent("Inquiry: open form");
          return;
        }
        var href = el.getAttribute("href") || "";
        if (href === "/reservations" || href === "/reservations/") {
          window.trackEvent("Reserve: click");
        } else if (href.indexOf("opentable.com") !== -1) {
          window.trackEvent("Reserve: OpenTable click");
        }
      });
    </script>

    <slot name="head" />
  </head>
  <body>
    <TopBar />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <CartDrawer client:only="react" />
  </body>
</html>
